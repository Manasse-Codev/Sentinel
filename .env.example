# ============================================================
# Sentinel — Variables d'environnement (exemple)
# Copier vers .env et remplir. Ne JAMAIS commiter .env.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=Sentinel
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Base de données ---
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5433/sentinel
DATABASE_URL_SYNC=postgresql+psycopg://sentinel:sentinel@localhost:5433/sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# --- Redis ---
REDIS_URL=redis://localhost:6381/0
REDIS_STREAM_EVENTS=sentinel:events
REDIS_STREAM_ALERTS=sentinel:alerts

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Sécurité ---
RATE_LIMIT_PER_MINUTE=120
MAX_PAYLOAD_SIZE_BYTES=1048576
PASSWORD_HASH_ALGORITHM=argon2

# --- IA ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=30

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_APP_NAME=Sentinel

# --- Observabilité ---
SENTRY_DSN=
METRICS_ENABLED=true
